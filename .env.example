# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (Project Settings → API Keys) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key: safe in the browser (used only for realtime, RLS applies)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key: server only, bypasses RLS. Used after the API has authorised a request.
SUPABASE_SECRET_KEY=sb_secret_...

# --- Gemini (https://aistudio.google.com/apikey) -----------------------------
# Optional: without it the app runs in degraded mode (rule-based triage,
# manual replies) and everything else keeps working.
GEMINI_API_KEY=
# Model chains: primary first, fallbacks tried on 429/5xx. Defaults shown.
# GEMINI_CLASSIFY_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# GEMINI_DRAFT_MODELS=gemini-2.5-flash,gemini-3.5-flash

# --- Misc ---------------------------------------------------------------------
# Bearer secret for the daily keep-alive cron (any random string, 16+ chars)
CRON_SECRET=
# Password given to every seeded demo account (default BookLeaf@2026)
# SEED_DEMO_PASSWORD=

# --- Only needed for the Supabase CLI (migrations) ----------------------------
# SUPABASE_ACCESS_TOKEN=sbp_...
# SUPABASE_DB_PASSWORD=
# SUPABASE_PROJECT_REF=
